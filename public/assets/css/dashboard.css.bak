*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

:root{
    --sidebar:#0f172a;
    --sidebar-light:#1e293b;
    --primary:#2563eb;
    --primary-2:#7c3aed;
    --bg:#f1f5f9;
    --card:#ffffff;
    --text:#0f172a;
    --muted:#64748b;
    --border:#e2e8f0;
    --success:#16a34a;
    --danger:#dc2626;
}

body{
    font-family:'Inter',sans-serif;
    background:var(--bg);
    color:var(--text);
}

/*
|--------------------------------------------------------------------------
| SIDEBAR
|--------------------------------------------------------------------------
*/

.sidebar{
    position:fixed;
    left:0;
    top:0;
    width:280px;
    height:100vh;
    background:linear-gradient(
        180deg,
        #0f172a,
        #111827
    );
    padding:1.5rem;
    z-index:1000;
    overflow:auto;
    box-shadow:
    10px 0 40px rgba(15,23,42,.15);
}

.sidebar-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:2rem;
}

.logo{
    color:white;
    font-size:1.8rem;
    font-weight:800;
    letter-spacing:.5px;
}

.close-btn{
    background:none;
    border:none;
    color:white;
    font-size:1.4rem;
    cursor:pointer;
}

.nav-links{
    display:flex;
    flex-direction:column;
    gap:.7rem;
}

.nav-links a{
    display:flex;
    align-items:center;
    gap:1rem;
    text-decoration:none;
    color:#cbd5e1;
    padding:1rem 1.2rem;
    border-radius:18px;
    transition:.25s ease;
    font-weight:600;
}

.nav-links a:hover{
    background:rgba(255,255,255,.08);
    color:white;
    transform:translateX(5px);
}

.nav-links a.active{
    background:linear-gradient(
        135deg,
        var(--primary),
        var(--primary-2)
    );
    color:white;
    box-shadow:
    0 10px 25px rgba(37,99,235,.35);
}

/*
|--------------------------------------------------------------------------
| MAIN
|--------------------------------------------------------------------------
*/

.main{
    margin-left:280px;
    min-height:100vh;
}

/*
|--------------------------------------------------------------------------
| TOPBAR
|--------------------------------------------------------------------------
*/

.topbar{
    height:90px;
    background:white;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:0 2rem;
    border-bottom:1px solid var(--border);
    position:sticky;
    top:0;
    z-index:900;
}

.left-navbar{
    display:flex;
    align-items:center;
    gap:1rem;
}

.menu-btn{
    width:48px;
    height:48px;
    border:none;
    border-radius:14px;
    background:#eff6ff;
    color:var(--primary);
    font-size:1.2rem;
    cursor:pointer;
}

.search-box{
    width:380px;
    background:#f8fafc;
    border:1px solid var(--border);
    border-radius:16px;
    display:flex;
    align-items:center;
    padding:0 1rem;
}

.search-box i{
    color:var(--muted);
}

.search-box input{
    width:100%;
    border:none;
    background:transparent;
    padding:1rem;
    outline:none;
}

.right-navbar{
    display:flex;
    align-items:center;
    gap:1rem;
}

.icon-btn{
    width:46px;
    height:46px;
    border:none;
    border-radius:14px;
    background:#f8fafc;
    cursor:pointer;
    font-size:1rem;
}

.avatar{
    width:48px;
    height:48px;
    border-radius:50%;
    background:linear-gradient(
        135deg,
        var(--primary),
        var(--primary-2)
    );
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:700;
}

/*
|--------------------------------------------------------------------------
| CONTENT
|--------------------------------------------------------------------------
*/

.content{
    padding:2rem;
}

/*
|--------------------------------------------------------------------------
| HERO
|--------------------------------------------------------------------------
*/

.hero{
    background:
    linear-gradient(
        135deg,
        var(--primary),
        var(--primary-2)
    );

    border-radius:32px;
    padding:3rem;
    color:white;
    margin-bottom:2rem;

    box-shadow:
    0 25px 60px rgba(37,99,235,.25);
}

.hero h1{
    font-size:3rem;
    font-weight:800;
    margin-bottom:1rem;
}

.hero p{
    font-size:1.1rem;
    opacity:.95;
}

/*
|--------------------------------------------------------------------------
| CARDS
|--------------------------------------------------------------------------
*/

.cards{
    display:grid;
    grid-template-columns:
    repeat(auto-fit,minmax(240px,1fr));
    gap:1.5rem;
    margin-bottom:2rem;
}

.card-modern{
    background:white;
    border-radius:24px;
    padding:2rem;
    box-shadow:
    0 10px 35px rgba(15,23,42,.06);
    transition:.25s ease;
    border:1px solid #f1f5f9;
}

.card-modern:hover{
    transform:translateY(-8px);
    box-shadow:
    0 25px 50px rgba(15,23,42,.12);
}

.card-modern i{
    font-size:2rem;
    margin-bottom:1rem;
    color:var(--primary);
}

.card-modern h2{
    font-size:2.5rem;
    margin-bottom:.5rem;
}

.card-modern p{
    color:var(--muted);
}

/*
|--------------------------------------------------------------------------
| TABLE
|--------------------------------------------------------------------------
*/

.table-box{
    background:white;
    border-radius:28px;
    overflow:hidden;
    box-shadow:
    0 10px 40px rgba(15,23,42,.06);
}

.table{
    margin:0;
}

.table thead{
    background:#f8fafc;
}

.table th{
    border:none;
    padding:1.2rem;
    color:#334155;
    font-weight:700;
}

.table td{
    padding:1.2rem;
    border-top:1px solid #f1f5f9;
}

/*
|--------------------------------------------------------------------------
| FOOTER
|--------------------------------------------------------------------------
*/

.footer{
    text-align:center;
    padding:2rem;
    color:var(--muted);
}

/*
|--------------------------------------------------------------------------
| RESPONSIVE
|--------------------------------------------------------------------------
*/

@media(max-width:992px){

    .sidebar{
        transform:translateX(-100%);
        transition:.3s ease;
    }

    .sidebar.active{
        transform:translateX(0);
    }

    .main{
        margin-left:0;
    }

    .search-box{
        width:220px;
    }

    .hero h1{
        font-size:2rem;
    }
}
