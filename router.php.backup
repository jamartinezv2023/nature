<?php

session_start();

require_once __DIR__ . '/src/Shared/Helpers/bootstrap.php';

use App\Interfaces\Http\Controllers\HealthController;

$uri =
    parse_url(
        $_SERVER['REQUEST_URI'],
        PHP_URL_PATH
    );

$method =
    $_SERVER['REQUEST_METHOD'];

$publicPath =
    __DIR__ . '/public';

$filePath =
    realpath($publicPath . $uri);

/*
|--------------------------------------------------------------------------
| ARCHIVOS ESTÁTICOS
|--------------------------------------------------------------------------
*/

if (
    $uri !== '/'
    &&
    $filePath
    &&
    str_starts_with(
        $filePath,
        realpath($publicPath)
    )
    &&
    is_file($filePath)
) {

    return false;
}

/*
|--------------------------------------------------------------------------
| API V1
|--------------------------------------------------------------------------
*/

switch (true) {

    /*
    |--------------------------------------------------------------------------
    | HEALTH CHECK
    |--------------------------------------------------------------------------
    */

    case $uri === '/api/v1/health':

        (new HealthController())->index();

        break;

    /*
    |--------------------------------------------------------------------------
    | LOGIN
    |--------------------------------------------------------------------------
    */

    case $uri === '/':

        require $publicPath . '/login.php';

        break;

    /*
    |--------------------------------------------------------------------------
    | DASHBOARD
    |--------------------------------------------------------------------------
    */

    case $uri === '/dashboard':

        require $publicPath . '/views/dashboard.php';

        break;

    /*
    |--------------------------------------------------------------------------
    | OTP
    |--------------------------------------------------------------------------
    */

    case $uri === '/verify-otp-submit':

        require __DIR__ . '/src/Controllers/OTPController.php';

        break;

    default:

        http_response_code(404);

        echo '404 NOT FOUND';

        break;
}
