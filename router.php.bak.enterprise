<?php

session_start();

require_once __DIR__ . '/vendor/autoload.php';

$uri = urldecode(
    parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH)
);

$publicPath = __DIR__ . '/public';

$filePath = realpath($publicPath . $uri);

/*
|--------------------------------------------------------------------------
| ARCHIVOS ESTÁTICOS
|--------------------------------------------------------------------------
*/

if (
    $uri !== '/'
    &&
    $filePath
    &&
    str_starts_with($filePath, realpath($publicPath))
    &&
    is_file($filePath)
) {
    return false;
}

/*
|--------------------------------------------------------------------------
| RUTAS
|--------------------------------------------------------------------------
*/

switch ($uri) {

    /*
    |--------------------------------------------------------------------------
    | HOME
    |--------------------------------------------------------------------------
    */

    case '/':

        require $publicPath . '/login.php';

        break;

    /*
    |--------------------------------------------------------------------------
    | LOGIN API
    |--------------------------------------------------------------------------
    */

    case '/api/auth/login':

        header('Content-Type: application/json');

        echo json_encode([
            'success' => true,
            'requires_2fa' => true,
            'message' => 'Primer factor correcto'
        ]);

        break;

    /*
    |--------------------------------------------------------------------------
    | VERIFY OTP SUBMIT
    |--------------------------------------------------------------------------
    */


    /*
    |--------------------------------------------------------------------------
    | DASHBOARD
    |--------------------------------------------------------------------------
    */

    case '/verify-otp-submit':

        require __DIR__ . '/src/Controllers/OTPController.php';

        break;


    case '/dashboard':

        require $publicPath . '/views//dashboard';

        break;

    /*
    |--------------------------------------------------------------------------
    | 404
    |--------------------------------------------------------------------------
    */

    default:

        http_response_code(404);

        echo '404 NOT FOUND';

        break;
}
