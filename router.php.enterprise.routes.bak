<?php

session_start();

require_once __DIR__ . '/vendor/autoload.php';

$uri = urldecode(
    parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH)
);

$publicPath = __DIR__ . '/public';

$filePath = realpath($publicPath . $uri);

/*
|--------------------------------------------------------------------------
| SERVIR ARCHIVOS ESTÁTICOS
|--------------------------------------------------------------------------
*/

if (
    $uri !== '/'
    &&
    $filePath
    &&
    str_starts_with($filePath, realpath($publicPath))
    &&
    is_file($filePath)
) {

    return false;
}

/*
|--------------------------------------------------------------------------
| RUTAS
|--------------------------------------------------------------------------
*/

switch ($uri) {

    /*
    |--------------------------------------------------------------------------
    | HOME
    |--------------------------------------------------------------------------
    */

    case '/':

        require $publicPath . '/login.php';

        break;

    /*
    |--------------------------------------------------------------------------
    | LOGIN API ENTERPRISE
    |--------------------------------------------------------------------------
    */

    case '/api/auth/login':

        require_once __DIR__
        . '/src/Application/Services/AuthService.php';

        require_once __DIR__
        . '/src/Interfaces/Http/Controllers/LoginController.php';

        $controller =
            new \Nature\Interfaces\Http\Controllers\LoginController();

        $controller->handle();

        break;

    /*
    |--------------------------------------------------------------------------
    | VERIFY OTP
    |--------------------------------------------------------------------------
    */

    case '/verify-otp-submit':

        require __DIR__
        . '/src/Controllers/OTPController.php';

        break;

    /*
    |--------------------------------------------------------------------------
    | DASHBOARD
    |--------------------------------------------------------------------------
    */

    case '/dashboard':

        require $publicPath
        . '/views/dashboard.php';

        break;

    /*
    |--------------------------------------------------------------------------
    | HEALTH CHECK
    |--------------------------------------------------------------------------
    */

    case '/api/v1/health':

        header('Content-Type: application/json');

        echo json_encode([
            'success' => true,
            'application' => 'Ecosistema Nature',
            'environment' => 'local',
            'timestamp' => date('Y-m-d H:i:s'),
            '_links' => [
                'self' => [
                    'href' => '/api/v1/health'
                ]
            ]
        ]);

        break;

    /*
    |--------------------------------------------------------------------------
    | 404
    |--------------------------------------------------------------------------
    */

    default:

        http_response_code(404);

        echo '404 NOT FOUND';

        break;
}
